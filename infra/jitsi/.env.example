# Domínio público, configurado no DNS com registro A/AAAA para este servidor.
PUBLIC_URL=https://meet.seu-dominio.gov.br
JITSI_DOMAIN=meet.seu-dominio.gov.br
TZ=America/Fortaleza

# Fixe uma versão estável testada antes de produção.
JITSI_IMAGE_VERSION=stable
CONFIG=~/.jitsi-meet-cfg
HTTP_PORT=8000
HTTPS_PORT=8443

# Autenticação JWT. Nunca envie JWT_APP_SECRET ao frontend.
ENABLE_AUTH=1
AUTH_TYPE=jwt
JWT_APP_ID=camara-ai
JWT_APP_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_64_CARACTERES
JWT_ACCEPTED_ISSUERS=camara-ai
JWT_ACCEPTED_AUDIENCES=jitsi
ENABLE_GUESTS=0

# Rede e mídia. Ajuste conforme o IP público/NAT do servidor.
DOCKER_HOST_ADDRESS=203.0.113.10
JVB_ADVERTISE_IPS=203.0.113.10
JVB_PORT=10000
JVB_TCP_HARVESTER_DISABLED=true

# Recursos e gravação. Jibri deve rodar em nó dedicado em produção.
ENABLE_RECORDING=0
ENABLE_LIVESTREAMING=0
