rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isConfiguredRoot() {
      return request.auth != null
        && exists(/databases/$(database)/documents/system-control/portal)
        && request.auth.token.get('email', '') in get(/databases/$(database)/documents/system-control/portal).data.get('security', {}).get('rootEmails', []);
    }

    function isAdminProfile() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tipo', '') in ['Admin', 'Administrador'];
    }

    function isOuvidoriaManager() {
      return request.auth != null && (
        isConfiguredRoot()
        || isAdminProfile()
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tipo', '') == 'Ouvidoria')
      );
    }

    // A gestão da Escola do Parlamento pode ser feita pelo administrador
    // global ou pelo perfil operacional específico da Escola, respeitando
    // as permissões configuradas no Controle do Sistema quando existentes.
    function isEscolaParlamentoManager() {
      return request.auth != null && (
        isConfiguredRoot()
        || isAdminProfile()
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tipo', '') == 'Escola do Parlamento'
          && hasModuleAdminAccess('escolaParlamento', ['Escola do Parlamento']))
      );
    }

    match /system-control/{documentId} {
      allow read: if documentId == 'portal';
      allow create: if documentId == 'portal'
        && isAdminProfile()
        && request.auth.token.email in request.resource.data.security.rootEmails;
      allow update: if documentId == 'portal' && (
        isConfiguredRoot()
        || (isAdminProfile()
          && !('security' in resource.data)
          && request.auth.token.email in request.resource.data.security.rootEmails)
      );
      allow delete: if documentId == 'portal' && isConfiguredRoot();
    }

    // Conteúdo institucional que pode ser consumido pelo portal, aplicativo e integrações públicas.
    match /noticias/{documentId} {
      allow read: if true;
      allow create, update, delete: if isConfiguredRoot() || isAdminProfile();
    }
    match /vereadores/{documentId} {
      allow read: if true;
      allow write: if isConfiguredRoot() || isAdminProfile();
    }
    match /piel/{documentId} {
      allow read: if true;
    }
    match /escola-parlamento-cursos/{documentId} {
      allow read: if true;
      allow write: if isEscolaParlamentoManager();
    }
    match /escola-parlamento-aulas/{documentId} {
      allow read: if true;
      allow write: if isEscolaParlamentoManager();
    }
    match /escola-parlamento-conteudos/{documentId} {
      allow read: if true;
      allow write: if isEscolaParlamentoManager();
    }
    match /escola-parlamento-noticias/{documentId} {
      allow read: if true;
      allow write: if isEscolaParlamentoManager();
    }
    match /escola-parlamento-matriculas/{documentId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isEscolaParlamentoManager());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isEscolaParlamentoManager());
    }
    match /escola-parlamento-progresso/{documentId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isEscolaParlamentoManager());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isEscolaParlamentoManager());
    }
    match /escola-parlamento-downloads/{documentId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isEscolaParlamentoManager());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isEscolaParlamentoManager());
    }
    match /escola-parlamento-respostas/{documentId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isEscolaParlamentoManager());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isEscolaParlamentoManager());
    }
    match /tv-camara-playlist/{documentId} {
      allow read: if true;
      allow write: if isConfiguredRoot() || isAdminProfile();
    }
    match /tv-camara-logs/{documentId} {
      allow read, write: if request.auth != null && (isConfiguredRoot() || isAdminProfile());
    }

    // O cidadão pode consultar somente suas próprias solicitações do Balcão,
    // incluindo registros antigos que guardavam o identificador em dadosUsuario.id.
    match /balcao-cidadao/{documentId} {
      allow read, write: if request.auth != null;
    }

    // Cadastro operacional de beneficiários. Os registros podem conter CPF,
    // telefone e outros dados pessoais; somente a gestão autenticada do
    // Balcão/administradores deve consultar ou alterar a coleção.
    match /beneficiarios/{documentId} {
      allow read: if request.auth != null && (
        isConfiguredRoot()
        || isAdminProfile()
        || hasModuleAdminAccess('balcao', ['Balcão', 'Recepção', 'Recepcao'])
        || resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && (
        hasModuleAdminAccess('balcao', ['Balcão', 'Recepção', 'Recepcao'])
        || request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if request.auth != null && (
        isConfiguredRoot()
        || isAdminProfile()
        || hasModuleAdminAccess('balcao', ['Balcão', 'Recepção', 'Recepcao'])
        || resource.data.userId == request.auth.uid
      );
    }

    // O aplicativo armazena os beneficiários do cidadão na coleção legada
    // `balcao` (com type == "beneficiario"). O cidadão só pode consultar e
    // alterar os próprios registros; a equipe autorizada do Balcão mantém a
    // visão administrativa.
    match /balcao/{documentId} {
      allow read: if request.auth != null && (
        isConfiguredRoot()
        || isAdminProfile()
        || hasModuleAdminAccess('balcao', ['Balcão', 'Recepção', 'Recepcao'])
        || resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && (
        hasModuleAdminAccess('balcao', ['Balcão', 'Recepção', 'Recepcao'])
        || request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if request.auth != null && (
        isConfiguredRoot()
        || isAdminProfile()
        || hasModuleAdminAccess('balcao', ['Balcão', 'Recepção', 'Recepcao'])
        || resource.data.userId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isConfiguredRoot() || isAdminProfile() || isLegislativeSecretariat());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && (request.auth.uid == userId || isConfiguredRoot() || isAdminProfile());
    }

    match /login-activities/{activityId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !('revoked' in request.resource.data)
        && request.resource.data.keys().hasOnly([
          'flavorId', 'userId', 'userEmail', 'deviceName', 'modelName',
          'osName', 'osVersion', 'platform', 'appVersion', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /balcao-config/{documentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (documentId == 'bookedSlots' || hasModuleAdminAccess('balcao', ['Admin', 'Balcão']));
    }
    match /balcao-monthly-configs/{monthId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && hasModuleAdminAccess('balcao', ['Admin', 'Balcão']);
    }
    match /atendimento-calendario/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /atendimento-fila/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /atendimento-fila-meta/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /atendimento-guiches/{documentId} {
      allow read, write: if request.auth != null;
    }
    // Cada abertura de guichê cria uma sessão nesta coleção. A regra explícita
    // evita que ambientes com uma regra geral mais restritiva bloqueiem a
    // transação depois de permitir a leitura dos guichês.
    match /atendimento-guiche-relatorios/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /atendimento-avaliacoes/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /assessoria-microempreendedor/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /ouvidoria/{documentId} {
      // O registro público só pode criar manifestações novas. A leitura e o
      // tratamento ficam restritos ao manifestante identificado e à equipe.
      allow create: if isOuvidoriaManager()
        || (request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tipo', '') in ['Recepção', 'Recepcao', 'Balcão'] )
        || (request.resource.data.status == 'Recebida'
          && request.resource.data.keys().hasOnly(['protocolo', 'userId', 'dadosUsuario', 'dadosManifestacao', 'status', 'etapaAtual', 'origem', 'dataManifestacao', 'ultimaAtualizacao'])
          && ((request.auth == null && request.resource.data.userId == 'anonimo'
              && request.resource.data.dadosManifestacao.tipoManifestacao == 'Denúncia')
            || (request.auth != null && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'anonimo'))));
      allow get, list: if isOuvidoriaManager()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isOuvidoriaManager();
    }
    match /procuradoria-mulher/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /piel-atendimentos/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /procon-atendimentos/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /procon-agendamentos/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /mail/{documentId} {
      allow read, write: if request.auth != null;
    }
    // Configurações operacionais usadas pelos módulos de recepção e atendimento.
    // O acesso continua condicionado à autenticação; o controle fino de edição
    // é feito pela interface e pelas funções de perfil dos módulos.
    match /ouvidoria-config/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /procon-config/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /microempreendedor-config/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /microempreendedor-monthly-configs/{documentId} {
      allow read, write: if request.auth != null;
    }
    match /procuradoria-mulher-btn-panico/{documentId} {
      allow read, write: if request.auth != null;
    }
    // Coleções operacionais legadas ainda utilizadas por telas administrativas.
    match /procon-consumidores/{documentId} { allow read, write: if request.auth != null; }
    match /procon-fornecedores/{documentId} { allow read, write: if request.auth != null; }
    match /procon-pareceres/{documentId} { allow read, write: if request.auth != null; }
    match /procon-audiencias/{documentId} { allow read, write: if request.auth != null; }
    match /atendimento-juridico/{documentId} { allow read, write: if request.auth != null; }
    match /denuncias-procon/{documentId} { allow read, write: if request.auth != null; }

    function hasModuleAdminAccess(moduleId, defaults) {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tipo', '');
      let control = exists(/databases/$(database)/documents/system-control/portal)
        ? get(/databases/$(database)/documents/system-control/portal).data : {};
      return request.auth != null
        && control.get('modules', {}).get(moduleId, {}).get('admin', false)
        && (isConfiguredRoot() || control.get('security', {}).get('rolePermissions', {}).get(role, {}).get(moduleId, {}).get('admin', role in defaults));
    }
    function hasAdministrativePermission(moduleId, action, defaults) {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tipo', '');
      let control = exists(/databases/$(database)/documents/system-control/portal)
        ? get(/databases/$(database)/documents/system-control/portal).data : {};
      let permission = moduleId + '.' + action;
      return request.auth != null
        && control.get('modules', {}).get(moduleId, {}).get('admin', false)
        && (isConfiguredRoot()
          || role in ['Admin', 'Administrador']
          || control.get('security', {}).get('actionPermissions', {}).get(role, {}).get(permission, role in defaults));
    }

    function canReadAdministrativeAudit() {
      return (resource.data.moduleId == 'contratos'
          && hasAdministrativePermission('contratos', 'gerenciar', ['Gestor de Contrato']))
        || (resource.data.moduleId == 'almoxarifado'
          && hasAdministrativePermission('almoxarifado', 'gerenciar', ['Almoxarifado']))
        || (resource.data.moduleId == 'patrimonio'
          && hasAdministrativePermission('patrimonio', 'gerenciar', ['Patrimônio']))
        || (resource.data.moduleId == 'manutencao'
          && hasAdministrativePermission('manutencao', 'gerenciar', ['Manutenção']))
        || (resource.data.moduleId == 'frotas'
          && hasAdministrativePermission('frotas', 'gerenciar', ['Frotas']));
    }

    function isReceptionStaff() {
      return request.auth != null && hasModuleAdminAccess('recepcao', ['Admin', 'Recepção', 'Recepcao', 'Balcão', 'Microempreendedor']);
    }
    function isCabinetMember(cabinetId) {
      return request.auth != null && exists(/databases/$(database)/documents/gabinetes-equipe/$(cabinetId + '_' + request.auth.uid));
    }
    function canOperateCabinet(cabinetId) {
      return isCabinetMember(cabinetId)
        && get(/databases/$(database)/documents/gabinetes-equipe/$(cabinetId + '_' + request.auth.uid)).data.get('nivelAcesso', 'operacional') in ['operacional', 'gestao'];
    }
    function canReadLegislative(cabinetId) {
      return request.auth != null && (
        cabinetId == request.auth.uid
        || isCabinetMember(cabinetId)
        || isAdminProfile()
        || isConfiguredRoot()
        || hasLegislativePermission('legislative.secretariat')
        || hasLegislativePermission('legislative.presidency')
        || hasLegislativePermission('legislative.commissionPresident')
        || hasLegislativePermission('legislative.rapporteur')
        || hasLegislativePermission('legislative.legalOpinion')
      );
    }
    function canManageLegislative(cabinetId) {
      return request.auth != null && (
        cabinetId == request.auth.uid
        || canOperateCabinet(cabinetId)
        || isConfiguredRoot()
      );
    }
    function isLegislativeSecretariat() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tipo', '') == 'Secretaria Legislativa'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('legislativePermissions', []).hasAny(['legislative.secretariat']))
        && hasModuleAdminAccess('legislativo', ['Secretaria Legislativa', 'Vereador']);
    }
    function hasLegislativePermission(permission) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('legislativePermissions', []).hasAny([permission])
        && hasModuleAdminAccess('legislativo', ['Vereador', 'Assessor', 'Secretaria Legislativa', 'Juridico']);
    }
    function isLegislativeManager(cabinetId) {
      return canManageLegislative(cabinetId)
        || isLegislativeSecretariat();
    }
    function canOperateLegislativeWorkflow(cabinetId) {
      return isLegislativeManager(cabinetId)
        || hasLegislativePermission('legislative.presidency')
        || hasLegislativePermission('legislative.commissionPresident')
        || hasLegislativePermission('legislative.rapporteur')
        || hasLegislativePermission('legislative.legalOpinion');
    }

    match /solicitacoes-vereadores/{requestId} {
      allow read: if request.auth != null && (
        isReceptionStaff()
        || hasModuleAdminAccess('agendaVereadores', ['Admin'])
        || resource.data.get('userId', '') == request.auth.uid
        || resource.data.dadosSolicitacao.vereadorId == request.auth.uid
        || isCabinetMember(resource.data.dadosSolicitacao.vereadorId)
      );
      allow create: if request.auth != null
        && request.resource.data.status in ['Aguardando Análise', 'RECEBIDA']
        && !request.resource.data.keys().hasAny(['aprovadoPor', 'appointmentDate', 'appointmentTime', 'horariosOferecidos'])
        && (request.resource.data.userId == request.auth.uid || isReceptionStaff())
        && (request.resource.data.tipoDemanda != 'Atendimento no gabinete'
          || isReceptionStaff()
          || exists(/databases/$(database)/documents/gabinetes-visitantes/$(request.resource.data.gabineteId + '_' + request.auth.uid)));
      allow update: if request.auth != null && (
        // Somente o parlamentar destinatário aceita o motivo e oferece horários.
        (resource.data.dadosSolicitacao.vereadorId == request.auth.uid
          && resource.data.status in ['Aguardando Análise', 'Aguardando Confirmação', 'Agendamento Liberado', 'Datas Liberadas']
          && request.resource.data.status in ['Agendamento Liberado', 'Datas Liberadas', 'Recusado']
          && (request.resource.data.status == 'Recusado' || request.resource.data.aprovadoPor == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'horariosOferecidos', 'aprovadoPor', 'analisadoPor', 'parecerVereador', 'analisadoEm', 'ultimaAtualizacao']))
        || (resource.data.status in ['Agendamento Liberado', 'Datas Liberadas']
          && resource.data.aprovadoPor == resource.data.dadosSolicitacao.vereadorId
          && (resource.data.userId == request.auth.uid || isReceptionStaff())
          && request.resource.data.status == 'Agendado'
          && {'date': request.resource.data.appointmentDate, 'time': request.resource.data.appointmentTime} in resource.data.horariosOferecidos
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'appointmentDate', 'appointmentTime', 'agendadoPor', 'ultimaAtualizacao']))
        || ((isReceptionStaff() || resource.data.dadosSolicitacao.vereadorId == request.auth.uid)
          && request.resource.data.status in ['Cancelado', 'Realizado']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ultimaAtualizacao', 'atualizadoPor']))
        || (isReceptionStaff() && resource.data.status == 'Agendado'
          && resource.data.aprovadoPor == resource.data.dadosSolicitacao.vereadorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusFila', 'tipoEntradaFila', 'confirmadoComAtraso', 'chegadaRecepcaoEm', 'ultimaAtualizacao', 'senhaAtendimento']))
        || ((resource.data.dadosSolicitacao.vereadorId == request.auth.uid || canOperateCabinet(resource.data.dadosSolicitacao.vereadorId))
          && resource.data.status == 'Agendado'
          && request.resource.data.status == 'Remarcação necessária'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'imprevistoEm']))
        || (canOperateCabinet(resource.data.gabineteId)
          && resource.data.tipoDemanda != 'Atendimento no gabinete'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'prioridade', 'responsavelId', 'tags', 'mensagemPublica', 'observacaoInterna', 'ultimaAtualizacao', 'atualizadoPor']))
      );
    }
    match /vereadores-agenda-config/{cabinetId}/agenda/{configId} {
      allow read: if request.auth != null && (cabinetId == request.auth.uid || isCabinetMember(cabinetId) || isConfiguredRoot());
      allow write: if request.auth != null && (cabinetId == request.auth.uid || canOperateCabinet(cabinetId) || isConfiguredRoot());
    }
    match /gabinetes-equipe/{memberId} {
      allow read: if request.auth != null && (
        resource.data.get('vereadorId', '') == request.auth.uid
        || resource.data.get('userId', '') == request.auth.uid
        || isConfiguredRoot()
      );
      allow create: if request.auth != null && (
        request.resource.data.vereadorId == request.auth.uid
        || isConfiguredRoot()
        || isAdminProfile()
      );
      allow update, delete: if request.auth != null && (
        resource.data.vereadorId == request.auth.uid
        || isConfiguredRoot()
        || isAdminProfile()
      );
    }
    match /gabinetes-tarefas/{itemId} {
      allow read: if request.auth != null && (resource.data.get('gabineteId', '') == request.auth.uid || isCabinetMember(resource.data.get('gabineteId', '')) || isAdminProfile() || isConfiguredRoot());
      allow create: if request.auth != null && (request.resource.data.gabineteId == request.auth.uid || canOperateCabinet(request.resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow update, delete: if request.auth != null && (resource.data.gabineteId == request.auth.uid || canOperateCabinet(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
    }
    match /gabinetes-eventos/{itemId} {
      allow read: if request.auth != null && (resource.data.get('gabineteId', '') == request.auth.uid || isCabinetMember(resource.data.get('gabineteId', '')) || isAdminProfile() || isConfiguredRoot());
      allow create: if request.auth != null && (request.resource.data.gabineteId == request.auth.uid || canOperateCabinet(request.resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow update, delete: if request.auth != null && (resource.data.gabineteId == request.auth.uid || canOperateCabinet(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
    }
    match /gabinetes-listas/{itemId} {
      allow read: if request.auth != null && (resource.data.get('gabineteId', '') == request.auth.uid || isCabinetMember(resource.data.get('gabineteId', '')) || isAdminProfile() || isConfiguredRoot());
      allow create: if request.auth != null && (request.resource.data.gabineteId == request.auth.uid || canOperateCabinet(request.resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow update, delete: if request.auth != null && (resource.data.gabineteId == request.auth.uid || canOperateCabinet(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
    }
    match /gabinetes-visitantes/{itemId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || resource.data.gabineteId == request.auth.uid
        || isCabinetMember(resource.data.gabineteId)
        || isAdminProfile()
        || isConfiguredRoot()
      );
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || canOperateCabinet(resource.data.gabineteId)
        || isAdminProfile()
        || isConfiguredRoot()
      );
    }
    match /gabinetes-mensagens/{messageId} {
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid
        || request.resource.data.gabineteId == request.auth.uid
        || canOperateCabinet(request.resource.data.gabineteId)
        || isAdminProfile()
        || isConfiguredRoot()
      );
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || resource.data.gabineteId == request.auth.uid
        || isCabinetMember(resource.data.gabineteId)
        || isAdminProfile()
        || isConfiguredRoot()
      );
    }
    match /gabinetes-demandas-historico/{historyId} {
      allow read: if request.auth != null && (resource.data.gabineteId == request.auth.uid || isCabinetMember(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow create: if request.auth != null && (request.resource.data.gabineteId == request.auth.uid || canOperateCabinet(request.resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow update, delete: if isAdminProfile() || isConfiguredRoot();
    }
    match /gabinetes-encaminhamentos/{itemId} {
      allow read: if request.auth != null && (resource.data.gabineteId == request.auth.uid || isCabinetMember(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow create: if request.auth != null && (request.resource.data.gabineteId == request.auth.uid || canOperateCabinet(request.resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow update, delete: if request.auth != null && (resource.data.gabineteId == request.auth.uid || canOperateCabinet(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
    }
    match /gabinetes-documentos/{itemId} {
      allow read: if request.auth != null && (resource.data.gabineteId == request.auth.uid || isCabinetMember(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow create: if request.auth != null && (request.resource.data.gabineteId == request.auth.uid || canOperateCabinet(request.resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow update, delete: if request.auth != null && (resource.data.gabineteId == request.auth.uid || canOperateCabinet(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
    }
    match /gabinetes-pastas/{itemId} {
      allow read: if request.auth != null && (resource.data.gabineteId == request.auth.uid || isCabinetMember(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow create: if request.auth != null && (request.resource.data.gabineteId == request.auth.uid || canOperateCabinet(request.resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
      allow update, delete: if request.auth != null && (resource.data.gabineteId == request.auth.uid || canOperateCabinet(resource.data.gabineteId) || isAdminProfile() || isConfiguredRoot());
    }
    match /legislativo_materias/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId);
      allow update: if canOperateLegislativeWorkflow(resource.data.gabineteId);
      allow delete: if isLegislativeManager(resource.data.gabineteId)
        && resource.data.status == 'Rascunho';
    }
    match /legislativo_tramitacoes/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if canOperateLegislativeWorkflow(request.resource.data.gabineteId);
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_documentos/{itemId} {
      allow read: if resource.data.public == true || canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId);
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_pareceres/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId)
        || hasLegislativePermission('legislative.legalOpinion')
        || hasLegislativePermission('legislative.rapporteur');
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_comissoes/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId);
      allow update: if isLegislativeManager(resource.data.gabineteId)
        || (request.auth != null
          && resource.data.presidentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'alternateIds', 'updatedAt', 'editHistory']));
      allow delete: if isConfiguredRoot() || isAdminProfile();
    }
    match /legislativo_sessoes/{itemId} {
      allow read: if resource.data.publicPanel == true || canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId);
      allow update: if isLegislativeManager(resource.data.gabineteId)
        || (request.auth != null
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tipo', '') == 'Vereador'
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendanceIds', 'updatedAt'])
              && request.resource.data.attendanceIds.toSet().difference(resource.data.attendanceIds.toSet()).hasOnly([request.auth.uid])
              && resource.data.attendanceIds.toSet().difference(request.resource.data.attendanceIds.toSet()).hasOnly([request.auth.uid]))
            || (resource.data.get('currentMatterPhase', '') == 'voting'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liveVotes', 'updatedAt'])
              && request.resource.data.get('liveVotes', {}).diff(resource.data.get('liveVotes', {})).affectedKeys().hasOnly([request.auth.uid]))
            || (resource.data.get('currentMatterPhase', '') == 'discussion'
              && resource.data.attendanceIds.hasAll([request.auth.uid])
              && resource.data.get('activeSpeakerId', '') != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['speakerTimeConcessions', 'updatedAt'])
              && request.resource.data.get('speakerTimeConcessions', {}).diff(resource.data.get('speakerTimeConcessions', {})).affectedKeys().hasOnly([request.auth.uid])
              && request.resource.data.speakerTimeConcessions[request.auth.uid].speakerId == resource.data.activeSpeakerId
              && request.resource.data.speakerTimeConcessions[request.auth.uid].matterId == resource.data.currentMatterId
              && request.resource.data.speakerTimeConcessions[request.auth.uid].seconds == 60)
          ));
      allow delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_relatorias/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId)
        || hasLegislativePermission('legislative.commissionPresident')
        || hasLegislativePermission('legislative.rapporteur');
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_reunioes_comissao/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId);
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_pautas/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId);
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_presencas/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId);
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_votacoes/{itemId} {
      allow read: if resource.data.publicPanel == true || canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId)
        || hasLegislativePermission('legislative.presidency');
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_atas/{itemId} {
      allow read: if resource.data.public == true || canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId) || hasLegislativePermission('legislative.minutes');
      allow update, delete: if isLegislativeManager(resource.data.gabineteId) || hasLegislativePermission('legislative.minutes');
    }
    match /legislativo_normas/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId);
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_relatorios/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create: if isLegislativeManager(request.resource.data.gabineteId)
        || hasLegislativePermission('legislative.commissionPresident');
      allow update, delete: if isLegislativeManager(resource.data.gabineteId);
    }
    match /legislativo_assuntos/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create, update, delete: if isLegislativeManager(request.resource.data.gabineteId);
    }
    match /legislativo_autorias/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create, update, delete: if isLegislativeManager(request.resource.data.gabineteId);
    }
    match /legislativo_anexacoes/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create, update, delete: if isLegislativeManager(request.resource.data.gabineteId);
    }
    match /legislativo_acompanhamentos/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create, update, delete: if isLegislativeManager(request.resource.data.gabineteId);
    }
    match /legislativo_unidades_tramitacao/{itemId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminProfile() || isConfiguredRoot();
    }
    match /legislativo_despachos_iniciais/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create, update, delete: if isLegislativeManager(request.resource.data.gabineteId);
    }
    match /legislativo_tipos_materia/{itemId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminProfile() || isConfiguredRoot();
    }
    match /legislativo_status_tramitacao/{itemId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdminProfile() || isConfiguredRoot();
    }
    match /videoconferencias/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow create, update, delete: if false;
    }
    match /videoconferencia_eventos/{itemId} {
      allow read: if request.auth != null && canReadLegislative(resource.data.gabineteId);
      allow write: if false;
    }
    match /legislativo_gravacoes/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow write: if false;
    }
    match /legislativo_transcricoes/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow write: if false;
    }
    match /legislativo_eventos_sessao/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow write: if false;
    }
    match /legislativo_jobs_transcricao/{itemId} {
      allow read: if canReadLegislative(resource.data.gabineteId);
      allow write: if false;
    }
    match /legislativo_configuracoes/{camaraId} {
      allow read: if request.auth != null;
      allow create, update: if hasModuleAdminAccess('legislativo', ['Admin', 'Administrador']);
      allow delete: if isAdminProfile() || isConfiguredRoot();
    }
    match /legislativo_configuracoes/{camaraId}/contadores/{counterId} {
      allow read: if request.auth != null;
      allow create, update: if hasModuleAdminAccess('legislativo', ['Admin', 'Administrador', 'Vereador', 'Assessor']);
      allow delete: if isAdminProfile() || isConfiguredRoot();
    }

    // Processos administrativos: o cidadão lê apenas os seus; operações e
    // documentos são gravados exclusivamente pelas Cloud Functions.
    function canOperateProtocol() {
      return request.auth != null
        && (isConfiguredRoot()
          || isAdminProfile()
          || hasModuleAdminAccess('protocolo', ['Admin', 'Administrador', 'Protocolo', 'Servidor', 'Gestor de Setor', 'Secretaria Legislativa', 'Vereador', 'Assessor']));
    }
    match /processes/{processId} {
      allow read: if canOperateProtocol() || (request.auth != null && resource.data.requesterId == request.auth.uid);
      allow write: if false;
      match /{subcollection}/{documentId} {
        allow read: if canOperateProtocol() || (request.auth != null && get(/databases/$(database)/documents/processes/$(processId)).data.requesterId == request.auth.uid && (subcollection == 'pendingItems' || resource.data.get('visibility', 'internal') == 'public'));
        allow write: if false;
      }
    }
    match /processTypes/{typeId} {
      allow read: if request.auth != null;
      allow write: if canOperateProtocol();
    }
    match /processFlows/{flowId} { allow read: if canOperateProtocol(); allow write: if canOperateProtocol(); }
    match /documentTemplates/{templateId} { allow read, write: if canOperateProtocol(); }
    match /processEvents/{eventId} { allow read: if canOperateProtocol(); allow write: if false; }
    match /protocolSettings/{settingId} { allow read: if request.auth != null; allow write: if canOperateProtocol(); }
    match /processCounters/{year} { allow read, write: if false; }

    // Chatbot WhatsApp: somente administradores configurados gerenciam a
    // integração, mensagens automáticas e fluxos.
    function canManageWhatsapp() {
      return request.auth != null
        && (isConfiguredRoot() || isAdminProfile()
          || hasModuleAdminAccess('whatsapp', ['Admin', 'Administrador']));
    }
    match /whatsappSettings/{settingId} { allow read, write: if canManageWhatsapp(); }
    match /whatsappAutomaticMessages/{messageId} { allow read, write: if canManageWhatsapp(); }
    match /whatsappFlows/{flowId} { allow read, write: if canManageWhatsapp(); }
    match /whatsappConversations/{conversationId} {
      allow read, update: if canManageWhatsapp();
      allow create, delete: if false;
    }
    match /whatsappMessages/{messageId} {
      allow read: if canManageWhatsapp();
      allow create: if canManageWhatsapp() && request.resource.data.direction == 'outbound';
      allow update, delete: if false;
    }
    match /institutionalEmails/{messageId} {
      allow read, write: if isConfiguredRoot() || isAdminProfile();
    }

    // Fundação dos módulos administrativos. As mutações de domínio ficam
    // reservadas às Cloud Functions para que numeração, estoque e auditoria
    // sejam gravados de forma atômica.
    match /departments/{departmentId} {
      allow read: if request.auth != null;
      allow write: if isConfiguredRoot() || isAdminProfile();
    }
    match /administrativeCounters/{counterId} {
      allow read, write: if false;
    }
    match /administrativeAuditLogs/{eventId} {
      allow read: if request.auth != null && canReadAdministrativeAudit();
      allow write: if false;
    }
    match /administrativeExports/{exportId} {
      allow read: if request.auth != null && resource.data.requestedBy == request.auth.uid;
      allow write: if false;
    }
    match /contracts/{recordId} {
      allow read: if hasAdministrativePermission('contratos', 'visualizar', ['Fiscal de Contrato', 'Gestor de Contrato', 'Gestor de Setor']);
      allow write: if false;
      match /{document=**} {
        allow read: if hasAdministrativePermission('contratos', 'visualizar', ['Fiscal de Contrato', 'Gestor de Contrato', 'Gestor de Setor']);
        allow write: if false;
      }
    }
    match /{collectionName}/{recordId} {
      allow read: if collectionName in ['inventoryProducts', 'inventoryWarehouses', 'inventoryBatches', 'inventoryMovements', 'materialRequests']
        && hasAdministrativePermission('almoxarifado', 'visualizar', ['Almoxarifado', 'Gestor de Setor']);
      allow write: if false;
    }
    match /materialRequests/{recordId}/{document=**} {
      allow read: if hasAdministrativePermission('almoxarifado', 'visualizar', ['Almoxarifado', 'Gestor de Setor']);
      allow write: if false;
    }
    match /{collectionName}/{recordId} {
      allow read: if collectionName in ['assets', 'assetMovements', 'assetInventories', 'assetEvents']
        && hasAdministrativePermission('patrimonio', 'visualizar', ['Patrimônio', 'Gestor de Setor']);
      allow write: if false;
    }
    match /assetInventories/{recordId}/{document=**} {
      allow read: if hasAdministrativePermission('patrimonio', 'visualizar', ['Patrimônio', 'Gestor de Setor']);
      allow write: if false;
    }
    match /{collectionName}/{recordId} {
      allow read: if collectionName in ['maintenanceTickets', 'maintenanceWorkOrders', 'maintenancePlans', 'maintenanceSchedules']
        && hasAdministrativePermission('manutencao', 'visualizar', ['Manutenção', 'Gestor de Setor']);
      allow write: if false;
    }
    match /maintenanceWorkOrders/{recordId}/{document=**} {
      allow read: if hasAdministrativePermission('manutencao', 'visualizar', ['Manutenção', 'Gestor de Setor']);
      allow write: if false;
    }
    match /{collectionName}/{recordId} {
      allow read: if collectionName in ['fleetVehicles', 'fleetDrivers', 'fleetFuelings', 'fleetMaintenance', 'fleetTires', 'fleetDocuments', 'fleetIncidents', 'fleetFines', 'fleetEvents']
        && hasAdministrativePermission('frotas', 'visualizar', ['Frotas', 'Gestor de Setor']);
      allow write: if false;
    }

    // Regras básicas para permitir operações autenticadas
    match /{document=**} {
      allow read, write: if request.auth != null
        && !document.matches('processes/.*') && !document.matches('processTypes/.*') && !document.matches('processFlows/.*') && !document.matches('documentTemplates/.*') && !document.matches('processEvents/.*') && !document.matches('protocolSettings/.*') && !document.matches('processCounters/.*') && !document.matches('esic-pedidos/.*')
        && !document.matches('esic-contadores/.*') && !document.matches('login-activities/.*')
        && !document.matches('system-control/.*') && !document.matches('vereadores/.*') && !document.matches('solicitacoes-vereadores/.*') && !document.matches('balcao-config/.*') && !document.matches('balcao-monthly-configs/.*') && !document.matches('vereadores-agenda-config/.*') && !document.matches('gabinetes-equipe/.*') && !document.matches('gabinetes-tarefas/.*') && !document.matches('gabinetes-eventos/.*') && !document.matches('gabinetes-listas/.*') && !document.matches('gabinetes-visitantes/.*') && !document.matches('gabinetes-mensagens/.*') && !document.matches('gabinetes-demandas-historico/.*') && !document.matches('gabinetes-encaminhamentos/.*') && !document.matches('gabinetes-documentos/.*') && !document.matches('gabinetes-pastas/.*') && !document.matches('legislativo_.*')
        && !document.matches('departments/.*') && !document.matches('administrativeCounters/.*') && !document.matches('administrativeAuditLogs/.*') && !document.matches('administrativeExports/.*')
        && !document.matches('contracts/.*') && !document.matches('inventoryProducts/.*') && !document.matches('inventoryWarehouses/.*') && !document.matches('inventoryBatches/.*') && !document.matches('inventoryMovements/.*') && !document.matches('materialRequests/.*')
        && !document.matches('assets/.*') && !document.matches('assetMovements/.*') && !document.matches('assetInventories/.*') && !document.matches('assetEvents/.*')
        && !document.matches('maintenanceTickets/.*') && !document.matches('maintenanceWorkOrders/.*') && !document.matches('maintenancePlans/.*') && !document.matches('maintenanceSchedules/.*')
        && !document.matches('fleetVehicles/.*') && !document.matches('fleetDrivers/.*') && !document.matches('fleetFuelings/.*') && !document.matches('fleetMaintenance/.*') && !document.matches('fleetTires/.*') && !document.matches('fleetDocuments/.*') && !document.matches('fleetIncidents/.*') && !document.matches('fleetFines/.*') && !document.matches('fleetEvents/.*')
        && !document.matches('whatsappSettings/.*') && !document.matches('whatsappAutomaticMessages/.*') && !document.matches('whatsappFlows/.*') && !document.matches('whatsappConversations/.*') && !document.matches('whatsappMessages/.*');
    }
  }
}
