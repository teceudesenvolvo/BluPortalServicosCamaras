rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /system-control/{documentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'leo@gmail.com';
    }

    // Regras básicas para permitir operações autenticadas
    match /{document=**} {
      allow read, write: if request.auth != null && !document.matches('system-control/.*');
    }
  }
}
