# Firebase Web SDK (valores públicos; configure no Vercel de cada Câmara)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_FIREBASE_FUNCTIONS_REGION=us-central1
REACT_APP_FIREBASE_YOUTUBE_FUNCTIONS_REGION=southamerica-east1

# Somente o domínio público da infraestrutura Jitsi. Nunca coloque JWT ou
# segredo Jitsi em variáveis REACT_APP_, pois elas são expostas no navegador.
REACT_APP_JITSI_DOMAIN=meet.seu-dominio.gov.br
