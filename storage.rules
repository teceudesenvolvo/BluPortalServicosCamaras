rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isConfiguredRoot() {
      let controlPath = /databases/(default)/documents/system-control/portal;
      let controlExists = request.auth != null
        && firestore.exists(controlPath);
      let control = controlExists ? firestore.get(controlPath).data : {};
      let rootEmails = control.get('security', {}).get('rootEmails', []);
      return request.auth != null
        && controlExists
        && rootEmails is list
        && request.auth.token.get('email', '') in rootEmails;
    }
    function hasAdministrativeModuleAccess(moduleId) {
      let profilePath = /databases/(default)/documents/users/$(request.auth.uid);
      let controlPath = /databases/(default)/documents/system-control/portal;
      let profileExists = request.auth != null
        && firestore.exists(profilePath);
      let controlExists = request.auth != null
        && firestore.exists(controlPath);
      let profile = profileExists ? firestore.get(profilePath).data : {};
      let control = controlExists ? firestore.get(controlPath).data : {};
      let role = profile.get('tipo', '');
      return request.auth != null
        && profileExists
        && controlExists
        && control.get('modules', {}).get(moduleId, {}).get('admin', false)
        && (role in ['Admin', 'Administrador']
          || isConfiguredRoot()
          || (moduleId == 'ged'
            && control.get('security', {}).get('rolePermissions', {})
              .get(role, {}).get('ged', {}).get('admin',
                role in ['Arquivista', 'Gestor de Arquivo', 'Servidor']))
          || control.get('security', {}).get('actionPermissions', {}).get(role, {}).get(moduleId + '.visualizar', false)
          || control.get('security', {}).get('rolePermissions', {}).get(role, {}).get(moduleId, {}).get('admin', false));
    }

    function hasGedManagerAccess() {
      let profilePath = /databases/(default)/documents/users/$(request.auth.uid);
      let controlPath = /databases/(default)/documents/system-control/portal;
      let profile = firestore.get(profilePath).data;
      let control = firestore.get(controlPath).data;
      let role = profile.get('tipo', '');
      let rootEmails = control.get('security', {}).get('rootEmails', []);
      let actionPermissions = control.get('security', {})
        .get('actionPermissions', {});
      return request.auth != null
        && control.get('modules', {}).get('ged', {}).get('admin', false)
        && (role in ['Admin', 'Administrador']
          || (rootEmails is list
            && request.auth.token.get('email', '') in rootEmails)
          || actionPermissions.get(role, {}).get('ged.gerenciar',
            role in ['Arquivista', 'Gestor de Arquivo']));
    }

    function canReadGedFile() {
      return hasGedManagerAccess()
        || (resource.metadata.get('gedAccessLevel', '') == 'internal'
          && hasAdministrativeModuleAccess('ged'));
    }

    function isContractSupplier(contractId) {
      let profile = firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)).data;
      let contract = firestore.get(
        /databases/(default)/documents/contracts/$(contractId)).data;
      return request.auth != null
        && profile.get('tipo', '') in ['Empresa', 'Fornecedor']
        && contract.get('supplierDocument', '') == profile.get('cnpj', '');
    }

    function isAllowedAdministrativeFile() {
      return request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*')
          || request.resource.contentType.matches('application/vnd\\.ms-(excel|powerpoint)')
          || request.resource.contentType.matches('text/(csv|plain|xml)')
          || request.resource.contentType.matches('application/xml'));
    }

    match /system-control/{tenant}/{allPaths=**} {
      allow read: if true;
      allow write: if isConfiguredRoot()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Os anexos administrativos devem usar caminhos versionados. O cliente
    // autorizado pode criar um arquivo, mas não substituir nem apagar a prova
    // documental por acesso direto ao Storage.
    match /administrativo/{moduleId}/{entityId}/{fileName} {
      allow read: if (moduleId == 'ged' && canReadGedFile())
        || (moduleId in ['contratos', 'almoxarifado', 'patrimonio', 'manutencao', 'frotas']
          && hasAdministrativeModuleAccess(moduleId));
      allow create: if (moduleId == 'ged'
          && hasGedManagerAccess()
          && entityId.size() > 0
          && fileName.size() > 0
          && request.resource.metadata.get('gedUploaderUid', '')
            == request.auth.uid
          && request.resource.metadata.get('gedAccessLevel', '')
            in ['internal', 'restricted', 'confidential']
          && isAllowedAdministrativeFile())
        || (moduleId in ['contratos', 'almoxarifado', 'patrimonio', 'manutencao', 'frotas']
          && hasAdministrativeModuleAccess(moduleId)
          && entityId.size() > 0
          && fileName.size() > 0
          && isAllowedAdministrativeFile());
      allow update, delete: if false;
    }

    match /institutional-email/{accountId}/{messageId}/{fileName} {
      allow read, write: if isConfiguredRoot() || (request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.tipo in ['Admin', 'Administrador']);
    }
    match /contracts/{contractId}/documents/{fileName} {
      allow read: if hasAdministrativeModuleAccess('contratos')
        || isContractSupplier(contractId);
      allow create: if hasAdministrativeModuleAccess('contratos')
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('image/.*'));
      allow update, delete: if false;
    }
    match /fornecedores/{supplierId}/{fileName=**} {
      allow read: if request.auth != null
        && (request.auth.uid == supplierId || isConfiguredRoot()
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.tipo in ['Admin', 'Administrador', 'Fiscal de Contrato', 'Gestor de Contrato']);
      allow create: if request.auth != null
        && (request.auth.uid == supplierId || isConfiguredRoot()
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.tipo in ['Admin', 'Administrador', 'Fiscal de Contrato', 'Gestor de Contrato'])
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/xml')
          || request.resource.contentType.matches('text/xml')
          || request.resource.contentType.matches('image/.*'));
      allow update, delete: if false;
    }

    match /{topLevel}/{allPaths=**} {
      allow read, write: if topLevel != 'system-control'
        && topLevel != 'esic'
        && topLevel != 'administrativo'
        && topLevel != 'fornecedores'
        && topLevel != 'contracts'
        && request.auth != null;
    }

    match /{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
