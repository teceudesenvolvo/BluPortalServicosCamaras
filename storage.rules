rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isConfiguredRoot() {
      return request.auth != null
        && request.auth.token.email in firestore.get(/databases/(default)/documents/system-control/portal).data.security.rootEmails;
    }

    match /system-control/{tenant}/{allPaths=**} {
      allow read: if true;
      allow write: if isConfiguredRoot()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{topLevel}/{allPaths=**} {
      allow read, write: if topLevel != 'system-control' && topLevel != 'esic' && request.auth != null;
    }

    match /{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
